{
  "name": "dt-toolbox",
  "description": "Data manipulation tool",
  "version": "7.5.0",
  "license": "MIT",
  "author": "Peter Naydenov",
  "main": "./dist/dtbox.umd.js",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/dtbox.esm.mjs",
      "require": "./dist/dtbox.cjs",
      "default": "./dist/dtbox.umd.js"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*",
    "./src/*": "./src/*"
  },
  "scripts": {
    "start": "node src/main.js",
    "test": "vitest run",
    "cover": "vitest run --coverage",
    "build": "rollup -c"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeterNaydenov/dt-toolbox.git"
  },
  "bugs": {
    "url": "https://github.com/PeterNaydenov/dt-toolbox/issues"
  },
  "homepage": "https://github.com/PeterNaydenov/dt-toolbox#readme",
  "dependencies": {
    "@peter.naydenov/walk": "6.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "rollup": "^4.63.1",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "flatten",
    "shallow",
    "data",
    "object",
    "structure",
    "dt"
  ],
  "files": [
    ".agents",
    "dist",
    "src",
    "README.md",
    "Changelog.md",
    "Migration.guide.md",
    "LICENSE"
  ],
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
