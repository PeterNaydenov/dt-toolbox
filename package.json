{
  "name": "dt-toolbox",
  "description": "Data manipulation tool",
  "version": "7.5.1",
  "license": "MIT",
  "author": "Peter Naydenov",
  "main": "./dist/dtbox.umd.js",
  "types": "./types/dtbox.d.cts",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./types/dtbox.d.mts",
        "default": "./dist/dtbox.esm.mjs"
      },
      "require": {
        "types": "./types/dtbox.d.cts",
        "default": "./dist/dtbox.cjs"
      },
      "default": {
        "types": "./types/dtbox.d.cts",
        "default": "./dist/dtbox.umd.js"
      }
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*",
    "./src/*": "./src/*"
  },
  "scripts": {
    "test": "vitest run",
    "cover": "vitest run --coverage",
    "build": "rollup -c"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PeterNaydenov/dt-toolbox.git"
  },
  "bugs": {
    "url": "https://github.com/PeterNaydenov/dt-toolbox/issues"
  },
  "homepage": "https://github.com/PeterNaydenov/dt-toolbox#readme",
  "dependencies": {
    "@peter.naydenov/walk": "7.0.1"
  },
  "devDependencies": {
    "@rollup/plugin-terser": "^1.0.0",
    "@vitest/coverage-v8": "^5.0.2",
    "rollup": "^4.63.5",
    "vitest": "^5.0.2"
  },
  "keywords": [
    "flatten",
    "shallow",
    "data",
    "object",
    "structure",
    "dt"
  ],
  "files": [
    "skills",
    "dist",
    "src",
    "types",
    "README.md",
    "Changelog.md",
    "Migration.guide.md",
    "LICENSE"
  ],
  "allowScripts": {
    "fsevents@2.3.3": true
  }
}
